<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{title}}</title>

  <link href="https://fonts.googleapis.com/css2?family=Raleway:wght@400;600&display=swap" rel="stylesheet">

  <!-- Prevent Apple/iOS dark mode overrides -->
  <meta name="color-scheme" content="light">
  <meta name="supported-color-schemes" content="light">
  
  <style>
    /* Email clients (especially iOS and Apple Mail) */
    body, html {
      background-color: #ffffff !important;
      color: #1f2937 !important;
      margin: 0;
      padding: 0;
      font-family: 'Raleway', sans-serif;
    }
    .main-container {
      background: #ffffff !important;
      border-radius: 8px;
      max-width: 700px;
      margin: 40px auto;
      padding: 30px 16px;
    }

    /* Override Apple Mail dark mode */
    @media (prefers-color-scheme: dark) {
      body, html, .main-container {
        background: #ffffff !important;
        color: #1f2937 !important;
      }
    }
  </style>
</head>
<body>
 <!-- Add this inside your <head> -->
<meta name="color-scheme" content="light only">
<meta name="supported-color-schemes" content="light only">

<!-- Email Header Section -->
<table
  class="email-root"
  width="100%"
  cellpadding="0"
  cellspacing="0"
  bgcolor="#0e105b"
  style="background-color:#0e105b !important; padding:2rem 0 0;
         font-family:'Raleway', Arial, sans-serif;
         margin:0 auto; color:#ffffff !important;
         -webkit-text-size-adjust:none; -ms-text-size-adjust:none;"
>
  <!-- Content Row -->
  <tr>
    <td class="content-cell" style="padding:0;">
      <!-- Center entire tr horizontally -->
      <table
        class="content-grid"
        width="100%"
        cellpadding="0"
        cellspacing="0"
        border="0"
        style="max-width:700px; margin:0 auto; text-align:center; background-color:#0e105b;"
      >
        <tr>
          <!-- Left Column (Text) - 65% -->
          <td
            class="left-col"
            valign="middle"
            style="vertical-align:middle; text-align:left;
                   padding-right:1rem; width:65%; background-color:#0e105b;"
          >
            <h1
              class="main-title"
              style="color:#ffffff !important; font-weight:bold;
                     font-size:42px; margin:0; line-height:1.2;"
            >
              {{main}}
            </h1>

            <h2
              class="subtitle"
              style="color:#ffffff !important; font-size:22px;
                     font-weight:600; margin:12px 0; line-height:1.3;"
            >
              {{subtitle}}
            </h2>

            <div class="cta-wrap" style="margin-top:10px;">
              <div
                class="cta-badge"
                style="background:#0206b8 !important;
                       padding:8px 16px; border-radius:6px;
                       font-weight:600; font-size:20px;
                       color:#ffffff !important;
                       box-shadow:0 0 20px #0206b8 !important;
                       width:fit-content;"
              >
                {{text}}
              </div>
            </div>
          </td>

          <!-- Right Column (Image) - 35% -->
          <td
            class="right-col"
            valign="middle"
            style="vertical-align: middle; text-align: right;
                   width:35%; background-color:#0e105b;"
          >
            <img
              class="hero-image"
              src="{{imageUrl}}"
              alt="Celebration Image"
              style="display: block; max-width: 100%; height: auto;"
            />
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<!-- Responsive Styles -->
<style>
  @media only screen and (max-width: 620px) {
    .content-grid tr { display: block !important; width: 100% !important; }
    .left-col, .right-col { display: block !important; width: 100% !important; max-width: 100% !important; text-align: center !important; padding: 0 !important; }
    .left-col { padding-bottom: 1.5rem !important; }
    .main-title { font-size: 32px !important; text-align: center !important; }
    .subtitle { font-size: 18px !important; text-align: center !important; }
    .cta-badge { margin: 0 auto !important; font-size: 18px !important; text-align: center !important; }
    .hero-image { margin: 0 auto !important; max-width: 300px !important; width: 100% !important; height: auto !important; }
    .logo-cell { text-align: center !important; }
    .logo-img { margin: 0 auto !important; max-width: 110px !important; height: auto !important; }
  }

  @media only screen and (max-width: 480px) {
    .main-title { font-size: 28px !important; }
    .subtitle { font-size: 16px !important; }
    .cta-badge { font-size: 16px !important; padding: 6px 12px !important; }
    .email-container { padding: 0 0.5rem !important; }
  }
</style>
  <div class="main-container">