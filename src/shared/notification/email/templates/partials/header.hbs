     <!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="x-apple-disable-message-reformatting">
  <meta name="color-scheme" content="light only">
  <meta name="supported-color-schemes" content="light only">
  <style>
    body, html {
      margin: 0 !important;
      padding: 0 !important;
      background-color: #0e105b !important;
      -webkit-text-size-adjust: 100%;
      -ms-text-size-adjust: 100%;
    }
  </style>
</head>
<body style="margin:0; padding:0; background-color:#0e105b !important;">

<table width="100%" height="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#0e105b" style="background-color:#0e105b !important; height:100% !important;">
  <tr>
    <td align="center" style="background-color:#0e105b !important; padding-left:1rem; padding-right:1rem;">

      <!-- Root Container -->
      <table width="100%" cellpadding="0" cellspacing="0" bgcolor="#0e105b" style="background:#0e105b !important; font-family:'Raleway', Arial, sans-serif; color:#ffffff !important; max-width:700px; margin:0 auto;">

        <!-- Logo -->
        <tr>
          <td align="center" style="padding-bottom:1rem; padding-top:2rem;  ">
            <img src="{{logoUrl}}" alt="Logo" style="display:block; max-width:130px; height:auto; margin:0 auto;" />
          </td>
        </tr>

        <!-- Text Content -->
        <tr>
          <td align="center" style="background:#0e105b !important; text-align:center; padding:1rem;">
            <h1 style="color:#ffffff !important; font-weight:bold; font-size:32px; margin:0; line-height:1.3;">
              {{main}}
            </h1>
            <h2 style="color:#ffffff !important; font-size:22px; font-weight:600; margin:12px 0; line-height:1.4;">
              {{subtitle}}
            </h2>
            <div style="margin-top:12px;">
              <div style="background:#0206b8 !important; padding:10px 20px; border-radius:6px; font-weight:600; font-size:20px; color:#ffffff !important; box-shadow:0 0 20px #0206b8 !important; display:inline-block;">
                {{text}}
              </div>
            </div>
          </td>
        </tr>

        <!-- Image Section -->
        <tr>
          <td align="center" style="background:#0e105b !important; text-align:center; padding:1rem 0 0;">
            <img src="{{imageUrl}}" alt="Celebration Image" style="display:block; max-width:350px; width:100%; height:auto; margin:0 auto;" />
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<!-- Responsive Styles -->
<style>
  @media only screen and (max-width: 620px) {
    .main-title {
      font-size: 28px !important;
    }
    .subtitle {
      font-size: 18px !important;
    }
    .cta-badge {
      font-size: 16px !important;
      padding: 6px 12px !important;
    }
    .hero-image {
      max-width: 280px !important;
    }
    .logo-img {
      max-width: 100px !important;
    }
  }

  @media only screen and (max-width: 480px) {
    .main-title {
      font-size: 24px !important;
    }
    .subtitle {
      font-size: 16px !important;
    }
    .cta-badge {
      font-size: 14px !important;
      padding: 5px 10px !important;
    }
  }
</style>

</body>
</html>

